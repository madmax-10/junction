{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run frontend",
			"type": "shell",
			"command": "npm",
			"args": ["start", "--", "--host", "127.0.0.1"],
			"options": {
				"cwd": "${workspaceFolder}/frontend",
				"env": {
					"PATH": "${env:HOME}/.local/share/nodejs/node-v24.22.1-darwin-arm64/bin:${env:PATH}"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run backend",
			"type": "shell",
			"command": "${workspaceFolder}/.venv-dev/bin/python",
			"args": ["manage.py", "runserver", "127.0.0.1:8000"],
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
