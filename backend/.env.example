# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.

# Google ADK / Gemini (agent LLM). Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Model used by every agent; override without code changes.
AGENT_MODEL=gemini-3.8-flash
# Optional server-owned dotted callable: factory(model_name=...) -> ADK BaseLlm.
# Leave blank for native Gemini. A Muse adapter must implement tools + JSON replies.
AGENT_MODEL_FACTORY=

# Optional callable(subject, comparables) -> {"weights": [{post_id, weight, reason}]}.
# Leave blank for Gemini; validation and server Decimal arithmetic apply to every provider.
VALUATION_WEIGHT_ADAPTER=
VALUATION_PROVIDER_NAME=
VALUATION_MODEL=

# Meta Model API key: Muse Spark image reading (Agents 3, 4, 6).
# Optional: MODEL_API_BASE_URL (default https://api.meta.ai/v1), MUSE_VISION_MODEL (default muse-spark-1.2).
MODEL_API_KEY=

# SerpApi Google Maps (nearby mechanics, Agent 6)
SERPAPI_API_KEY=

# Evidence weighting for valuation uses the existing AGENT_MODEL and GOOGLE_API_KEY.
# No provider key / provider failure => insufficient_data; no median fallback.
# Output price_basis=asking is not calibrated against real sales.
